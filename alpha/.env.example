# Alpha environment template. Copy to alpha/.env and fill in. NEVER put real values in this file:
# it is tracked by git. alpha/.env and alpha/service_account.json are git-ignored.

# Supabase (service role key: server-side only)
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Fetch fresh free yfinance data each run (no API key needed). Set to 1 to enable.
INGEST_LIVE=0

# Optional safety: refuse to run unless SUPABASE_URL contains this text (your project ref).
ALPHA_EXPECT_PROJECT=

# Optional paid data sources (not used by the free path)
POLYGON_API_KEY=
FMP_API_KEY=
MASSIVE_API_KEY=

# Optional Google Sheets push. Use EITHER the JSON text below OR a git-ignored alpha/service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Optional failure alerts
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
API_AUTH_TOKEN=
