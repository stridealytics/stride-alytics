# ============================================================================
# StrideAlytics Backend — environment variables
# Copy to `.env` and fill in real values. Never commit the `.env` file.
# ============================================================================

# --- App ---
APP_NAME=StrideAlytics
DEBUG=false
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Supabase / Postgres) ---
# Leave DATABASE_URL unset for local development; the backend uses in-memory SQLite.
# To intentionally connect to Supabase, set its transaction-pooler connection URL.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DATABASE_POOL_SIZE=5

# --- Supabase Auth ---
# Optional for local dev-token auth. Configure these only when using Supabase Auth.
# SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # server-only, never expose to the browser
# SUPABASE_JWT_SECRET=

# --- Notifications ---
SENDGRID_API_KEY=SG....            # weekly picks email
SLACK_WEBHOOK=https://hooks.slack.com/services/...   # failure alerts

# --- Internal scheduler (optional, for self-hosted cron) ---
ENABLE_INTERNAL_SCHEDULER=false
