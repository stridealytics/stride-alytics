# =============================================================================
# StrideAlytics — Environment Variable Template
# Copy this file to .env and fill in your values.
# =============================================================================

# ── App Backend (FastAPI / Uvicorn) ─────────────────────────────────────────────
APP_NAME=StrideAlytics
DEBUG=false

ENVIRONMENT=development

# ── Database (Supabase / PostgreSQL) ────────────────────────────────────────
DATABASE_URL=
DATABASE_POOL_SIZE=5

# ── Auth (Supabase) ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Notifications ---
SENDGRID_API_KEY=            # weekly picks email
SLACK_WEBHOOK=               # failure alerts, e.g. https://hooks.slack.com/services/...