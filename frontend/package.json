{
  "name": "stride-alytics-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','.vite','node_modules/.vite','node_modules/.cache','tsconfig.tsbuildinfo']){try{fs.rmSync(d,{recursive:true,force:true});console.log('removed',d);}catch(e){}}\"",
    "prebuild": "npm run clean && npm run type-check",
    "build:dev": "npm run prebuild && vite build --mode development",
    "build:prod": "npm run prebuild && vite build --mode production",
    "build": "npm run build:prod",
    "preview": "vite preview",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm run lint",
    "test": "vitest run",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.11.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "husky": "^9.0.11",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
